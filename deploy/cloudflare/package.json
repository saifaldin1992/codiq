{
  "name": "codiq-cloudflare",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that fronts the platform container (Cloudflare Containers).",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "typescript": "5.6.3",
    "wrangler": "4.165.0"
  }
}
