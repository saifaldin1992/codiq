# ─────────────────────────────────────────────────────────────────────────────
# CODIQ — environment template. Copy to `.env` (git-ignored) and fill in.
# Generate secrets with:  openssl rand -base64 48
# `pnpm env:check` validates a filled environment before you boot.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
# Public origin of the platform (password-reset and unsubscribe links are built from it).
CODIQ_PUBLIC_BASE_URL=http://localhost:3000
# With NODE_ENV=production and an https:// base URL, plain http is redirected (GET) or refused (426).
# Only for a proxy that does not send X-Forwarded-Proto: CODIQ_ENFORCE_HTTPS=false

# ── Database (PostgreSQL 16+) ────────────────────────────────────────────────
# Supabase: runtime goes through the pooler (Supavisor, transaction mode, :6543),
# migrations through the direct/session connection (:5432).
#   CODIQ_POSTGRES_URL=postgresql://codiq_app:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
#   CODIQ_POSTGRES_URL_UNPOOLED=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Security pass 2026-11:
#   · a database across a network needs ?sslmode=require (or verify-full) — `pnpm env:check` fails without it.
#     A private network with no certificate (a compose `db` service) says so: CODIQ_DATABASE_PLAINTEXT_OK=true
#   · the APP runs as `codiq_app` (rows only — deploy/database/least-privilege.sql); the UNPOOLED URL
#     stays on the owner role, because `prisma migrate deploy` uses it.
CODIQ_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/codiq_dev?schema=public
CODIQ_POSTGRES_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/codiq_dev?schema=public

# ── Secrets (required outside NODE_ENV=development) ──────────────────────────
# Signs session tokens. Rotate by moving the old value to *_PREVIOUS.
SESSION_JWT_SECRET=
SESSION_JWT_SECRET_PREVIOUS=
# Encrypts TOTP secrets and provider keys at rest. A SEPARATE root from the JWT secret.
CODIQ_ENCRYPTION_KEY=
CODIQ_ENCRYPTION_KEY_PREVIOUS=

# ── Product images: any S3-compatible store ──────────────────────────────────
# Cloudflare R2:  endpoint https://<account-id>.r2.cloudflarestorage.com, region auto
# Supabase:       endpoint https://<ref>.supabase.co/storage/v1/s3, region = project region
PRODUCT_S3_ENDPOINT=
PRODUCT_S3_REGION=auto
PRODUCT_S3_BUCKET=
PRODUCT_S3_ACCESS_KEY_ID=
PRODUCT_S3_SECRET_ACCESS_KEY=
PRODUCT_S3_FORCE_PATH_STYLE=true

# ── Email (transactional) ────────────────────────────────────────────────────
# Either an HTTP provider key (Resend) or SMTP.
CODIQ_MAIL_FROM=
CODIQ_SUPPORT_EMAIL=
CODIQ_RESEND_API_KEY=
CODIQ_RESEND_WEBHOOK_SECRET=
CODIQ_SMTP_HOST=
CODIQ_SMTP_PORT=587
CODIQ_SMTP_SECURE=false
CODIQ_SMTP_USER=
CODIQ_SMTP_PASS=
CODIQ_SMTP_FROM=

# ── Edge / network ───────────────────────────────────────────────────────────
# Set to `cloudflare` ONLY when every request reaches the app through Cloudflare;
# the client IP is then read from CF-Connecting-IP (rate limits key on it).
CODIQ_TRUSTED_EDGE=
CODIQ_COOKIE_SECURE=

# ── Background worker & jobs ─────────────────────────────────────────────────
# `off` disables the notification worker in this process (e.g. when it runs as its own service).
CODIQ_NOTIFICATIONS_WORKER=
CODIQ_NOTIFICATIONS_INTERVAL_MS=
# Storefront page views are summed in memory and flushed every N ms (0 = write-through).
CODIQ_VISIT_FLUSH_MS=5000
CODIQ_SHUTDOWN_GRACE_MS=

# ── Backups (separate bucket and key; see docs/DISASTER_RECOVERY.md) ─────────
CODIQ_BACKUP_ENCRYPTION_KEY=
CODIQ_BACKUP_S3_ENDPOINT=
CODIQ_BACKUP_S3_REGION=auto
CODIQ_BACKUP_S3_BUCKET=
CODIQ_BACKUP_S3_ACCESS_KEY_ID=
CODIQ_BACKUP_S3_SECRET_ACCESS_KEY=
CODIQ_BACKUP_S3_FORCE_PATH_STYLE=true

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Development only ─────────────────────────────────────────────────────────
# Lets tests/dev bootstrap platform owners. NEVER set in a deployed environment.
CODIQ_ALLOW_OWNER_REGISTRATION=
CODIQ_DEMO_MODE=

# Marketplace M11 — the map's background (optional). An https tile template with
# {z} {x} {y}; the browser never sees it (tiles go through /api/market/map/tiles),
# so a provider key may sit in the query string. Unset: pins on a plain background.
CODIQ_MAP_TILE_URL=
CODIQ_MAP_TILE_ATTRIBUTION=
CODIQ_MAP_MAX_ZOOM=

# Marketplace M13a — online card payment and instalments (optional). "fake" turns on
# the TEST providers (development only: they approve on a click). The secret signs and
# checks every provider notification — at least 32 characters.
CODIQ_PAYMENTS_PROVIDER=
CODIQ_PAYMENTS_WEBHOOK_SECRET=
