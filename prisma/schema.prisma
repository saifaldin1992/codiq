generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformOwner {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String                 @unique @db.Text
  passwordHash  String                 @map("password_hash") @db.Text
  displayName   String                 @map("display_name") @db.Text
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      PlatformOwnerSession[]
  settlements   Settlement[]
  decidedUpgradeRequests PlanUpgradeRequest[]

  /// Phase 19 (ق-123): TOTP second factor. `totpLastStep` is what makes a code
  /// single-use — a code from a spent step is refused though its arithmetic
  /// still checks out. The secret is stored in clear; 19-د owes it encryption.
  totpSecret    String?   @map("totp_secret") @db.Text
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  totpLastStep  BigInt?   @map("totp_last_step")
  recoveryCodes PlatformOwnerRecoveryCode[]
  verifiedStores Store[] @relation("StoreVerifiedByOwner")

  @@map("platform_owners")
}

model Merchant {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String            @unique @db.Text
  passwordHash  String            @map("password_hash") @db.Text
  businessName  String            @map("business_name") @db.Text
  // P27-12 (ق-100): the partial unique index on phone_normalized lives ONLY in
  // migration 20260829090000 — Prisma cannot express a partial index, and putting
  // @unique here would generate a second FULL unique index and create drift.
  // Do not add it.
  ownerName       String?  @map("owner_name") @db.Text
  phone           String?  @db.Text
  phoneNormalized String?  @map("phone_normalized") @db.Text
  isActive      Boolean           @default(true) @map("is_active")
  approvalStatus String           @default("approved") @map("approval_status") @db.Text
  /// ق-218: set while this account's password is one a platform actor chose for
  /// it; cleared when the merchant sets his own. Every merchant surface except
  /// «change my password» is refused while it is set.
  passwordSetByProvisionerAt DateTime? @map("password_set_by_provisioner_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  stores        Store[]
  sessions      MerchantSession[]
  subscriptions MerchantSubscription[]
  settlements   Settlement[]
  planUpgradeRequests PlanUpgradeRequest[]
  availabilityOverrides AvailabilityOverride[]
  featureFlagRules FeatureFlagRule[]
  maintenanceWindows MaintenanceWindow[]
  settings MerchantSetting[]

  // 20-3: the two platform lists over this table paged (createdAt, id) desc and
  // (businessName, id) asc across ALL tenants against a table that declared no
  // index at all. A THIRD index — (created_at, id) WHERE approval_status =
  // 'pending' — serves the registration queue and lives ONLY in migration
  // 20260905140000: Prisma cannot express a partial index, exactly as with
  // phone_normalized above. Do not add it here.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "merchants_created_id_idx")
  @@index([businessName, id], map: "merchants_business_name_id_idx")
  @@map("merchants")
}

model Plan {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String                 @unique @db.Text
  name            String                 @db.Text
  monthlyPriceIqd Int                    @default(0) @map("monthly_price_iqd")
  commissionBps   Int                    @default(0) @map("commission_bps")
  isActive        Boolean                @default(true) @map("is_active")
  /**
   * Owner-controlled «توصية المنصة» badge on the public pricing grid. At most one
   * plan may carry it: the service clears the others inside a transaction, and a
   * partial unique index (`plans_single_recommended`, migration 20260827170000)
   * makes the invariant structural. Default false — no plan is recommended until
   * the owner says so, and then the pricing grid shows no badge at all.
   */
  isRecommended   Boolean                @default(false) @map("is_recommended")
  sortOrder       Int                    @default(0) @map("sort_order")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  features        PlanFeature[]
  /// Phase 30: published terms; a subscription is pinned to one (plan_versions is append-only).
  versions        PlanVersion[]
  subscriptions   MerchantSubscription[]
  upgradeRequests PlanUpgradeRequest[]
  featureFlagRules FeatureFlagRule[]

  @@map("plans")
}

model PlanFeature {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  featureCode String   @map("feature_code") @db.Text
  limitValue  Int      @map("limit_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode], map: "plan_features_unique")
  @@index([planId], map: "plan_features_plan_idx")
  @@map("plan_features")
}

/// Phase 30: one published set of a plan's terms. Never updated — a term change
/// publishes the next version. `limits` is {feature_code: limit}.
model PlanVersion {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String                 @map("plan_id") @db.Uuid
  version         Int
  monthlyPriceIqd Int                    @map("monthly_price_iqd")
  commissionBps   Int                    @map("commission_bps")
  limits          Json                   @default("{}") @db.JsonB
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  plan            Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions   MerchantSubscription[]

  @@unique([planId, version], map: "plan_versions_plan_version_key")
  @@unique([id, planId], map: "plan_versions_id_plan_key")
  @@map("plan_versions")
}

model MerchantSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  planId     String    @map("plan_id") @db.Uuid
  /// Phase 30: filled by the `merchant_subscriptions_pin_version` trigger with the
  /// plan's latest version when omitted. Never pass it from application code.
  planVersionId String @default(dbgenerated()) @map("plan_version_id") @db.Uuid
  status     String    @default("active") @db.Text
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion PlanVersion @relation(fields: [planVersionId, planId], references: [id, planId], onDelete: Restrict, map: "merchant_subscriptions_plan_version_fkey")

  @@index([merchantId], map: "merchant_subscriptions_merchant_idx")
  @@index([planVersionId], map: "merchant_subscriptions_plan_version_idx")
  @@index([planId], map: "merchant_subscriptions_plan_idx")
  @@map("merchant_subscriptions")
}

model PlanUpgradeRequest {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String         @map("merchant_id") @db.Uuid
  requestedPlanId String         @map("requested_plan_id") @db.Uuid
  status          String         @default("pending") @db.Text
  note            String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  decidedById     String?        @map("decided_by") @db.Uuid
  /// 19-ب: the deciding platform-staff member, with a TEXT snapshot label —
  /// SetNull mirrors the owner column, the label is what survives.
  decidedByStaffId String?       @map("decided_by_staff_id") @db.Uuid
  decidedByLabel  String?        @map("decided_by_label") @db.Text
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  requestedPlan   Plan           @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)
  decidedBy       PlatformOwner? @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedByStaff  PlatformStaff? @relation("UpgradeRequestDecidedByStaff", fields: [decidedByStaffId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "plan_upgrade_requests_status_created_idx")
  @@index([merchantId], map: "plan_upgrade_requests_merchant_idx")
  @@index([requestedPlanId], map: "plan_upgrade_requests_plan_idx")
  @@index([decidedByStaffId], map: "plan_upgrade_requests_decided_by_staff_idx")
  // 20-3: the list orders (createdAt, id) desc and filters `status` only
  // sometimes, so the index above — which LEADS with status — cannot serve it.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "plan_upgrade_requests_created_id_idx")
  @@map("plan_upgrade_requests")
}

model Store {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId           String                @map("merchant_id") @db.Uuid
  name                 String                @db.Text
  slug                 String                @unique @db.Text
  customDomain         String?               @unique @map("custom_domain") @db.Text
  defaultSubdomain     String                @unique @map("default_subdomain") @db.Text
  isActive             Boolean               @default(true) @map("is_active")
  // MD-1: temporary "closed for new orders" — browsing stays open, checkout is refused.
  vacationMode         Boolean               @default(false) @map("vacation_mode")
  vacationMessage      String?               @map("vacation_message") @db.Text
  /// ق-249: the ONE named store state; `is_active`/`vacation_mode` are a mirror kept by the
  /// `stores_status_sync` trigger. active | paused | maintenance | suspended | closed.
  status               String                @default("active") @db.Text
  statusMessage        String?               @map("status_message") @db.Text
  maintenanceUntil     DateTime?             @map("maintenance_until") @db.Timestamptz(3)
  /// ق-199: the storefront the merchant owns — identity, announcement strip,
  /// contact, social handles, written policies, guest checkout and the
  /// front-page sections. Every field here is edited from ONE screen
  /// («واجهة المتجر») and read by ONE public payload (`/store/:slug/public-config`);
  /// `storefront-config.guard.mjs` holds those two lists equal.
  logoObjectKey        String?  @unique @map("logo_object_key") @db.Text
  logoContentType      String?  @map("logo_content_type") @db.Text
  logoByteSize         Int?     @map("logo_byte_size")
  headline             String?  @db.Text
  subline              String?  @db.Text
  announcementEnabled  Boolean  @default(false) @map("announcement_enabled")
  announcementText     String?  @map("announcement_text") @db.Text
  supportEmail         String?  @map("support_email") @db.Text
  supportPhone         String?  @map("support_phone") @db.Text
  supportWhatsapp      String?  @map("support_whatsapp") @db.Text
  addressLine          String?  @map("address_line") @db.Text
  city                 String?  @db.Text
  socialFacebook       String?  @map("social_facebook") @db.Text
  socialInstagram      String?  @map("social_instagram") @db.Text
  socialX              String?  @map("social_x") @db.Text
  socialTiktok         String?  @map("social_tiktok") @db.Text
  socialSnapchat       String?  @map("social_snapchat") @db.Text
  socialYoutube        String?  @map("social_youtube") @db.Text
  policyReturn         String?  @map("policy_return") @db.Text
  policyPrivacy        String?  @map("policy_privacy") @db.Text
  policyDelivery       String?  @map("policy_delivery") @db.Text
  guestCheckoutEnabled Boolean  @default(true) @map("guest_checkout_enabled")
  homeSections         Json     @default("[]") @map("home_sections") @db.JsonB
  /// ق-211: the merchant's own footer pages — [{slug,title,body}], shaped by zod.
  customPages          Json     @default("[]") @map("custom_pages") @db.JsonB
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// PG-8 (ق-76): the only two onboarding facts the data cannot derive.
  /// Every other step is read from reality — a product exists, a rate is on,
  /// the store is active — because a manual flag drifts the moment he deletes
  /// the product it claims he created.
  onboardingPreviewSeenAt DateTime? @map("onboarding_preview_seen_at") @db.Timestamptz(6)
  onboardingDismissedAt   DateTime? @map("onboarding_dismissed_at") @db.Timestamptz(6)
  /// MD-6: an owner-granted verification badge. Either both of the first two
  /// are set or neither -- a claim the platform makes to shoppers always names
  /// the owner who made it. History lives in store_audit_events.
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByOwnerId    String?   @map("verified_by_owner_id") @db.Uuid
  verificationNote     String?   @map("verification_note") @db.Text
  verifiedByOwner      PlatformOwner? @relation("StoreVerifiedByOwner", fields: [verifiedByOwnerId], references: [id], onDelete: Restrict)
  merchant             Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customers            Customer[]
  paymentMethods       PaymentMethod[]
  notificationSettings NotificationSettings?
  deliveryRates        DeliveryRate[]
  merchantSessions     MerchantSession[]
  products             Product[]
  categories           ProductCategory[]
  productImages        ProductImage[]
  inventoryMovements   InventoryMovement[]
  orders               StoreOrder[]
  orderStatusEvents    OrderStatusEvent[]
  shoppingCarts        ShoppingCart[]
  customerAddresses    CustomerAddress[]
  checkoutRequests     CheckoutRequest[]
  posDevices           PosDevice[]
  posTickets           PosTicket[]
  posTicketShortfalls  PosTicketShortfall[]
  posPriceDeviations   PosPriceDeviation[]
  inventoryReservations InventoryReservation[]
  staffMemberships     StoreStaffMembership[]
  notificationOutbox   NotificationOutbox[]
  notificationUnsubscribes NotificationUnsubscribe[]
  notificationComplaints   NotificationComplaint[]
  ledgerEntries        LedgerEntry[]
  coupons              Coupon[]
  couponRedemptions    CouponRedemption[]
  orderPrescriptions   OrderPrescription[]
  marketingSettings    StoreMarketingSettings?
  orderNotes           OrderNote[]
  orderTags            OrderTag[]
  whatsappSends        OrderWhatsappSend[]
  auditEvents          StoreAuditEvent[]
  /// PR-1: customer reset tokens only — a storefront customer is keyed per store.
  passwordResetTokens  PasswordResetToken[]

  @@index([merchantId])
  // 20-3: the platform store directory pages (createdAt, id) desc across all tenants.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "stores_created_id_idx")
  @@map("stores")
  productReviews ProductReview[]
  wishlistItems  WishlistItem[]
  returnRequests ReturnRequest[]
  /// CD-5: off until the merchant turns it on — nobody discovers he has been
  /// giving discounts because an update defaulted a programme on.
  loyaltyEnabled       Boolean @default(false) @map("loyalty_enabled")
  loyaltyEarnPer1000   Int     @default(10) @map("loyalty_earn_per_1000")
  loyaltyPointValueIqd Int     @default(10) @map("loyalty_point_value_iqd")
  loyaltyEntries LoyaltyEntry[]
  banners            StoreBanner[]
  visitsDaily        StoreVisitDaily[]
  availabilityOverrides AvailabilityOverride[]
  featureFlagRules   FeatureFlagRule[]
  maintenanceWindows MaintenanceWindow[]
}

/**
 * PG-2 — store-scoped "who did what" trail for soft delete / restore / purge.
 *
 * Append-only: the store_audit_events_immutable trigger refuses UPDATE and
 * DELETE from every surface (the one exemption is the cascade of a store
 * deletion). `entityId` and `actorId` deliberately carry NO foreign key — the
 * record must outlive its subject, which the 30-day purge hard-deletes — so the
 * labels are text SNAPSHOTS taken at the moment of the action, not joins.
 */
model StoreAuditEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  entityType      String   @map("entity_type") @db.Text
  entityId        String   @map("entity_id") @db.Uuid
  entityLabel     String   @map("entity_label") @db.Text
  entitySecondary String?  @map("entity_secondary") @db.Text
  action          String   @db.Text
  actorKind       String   @map("actor_kind") @db.Text
  actorId         String?  @map("actor_id") @db.Uuid
  actorLabel      String   @map("actor_label") @db.Text
  metadata        Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deletedProducts    Product[]              @relation("ProductDeletedEvent")
  deletedVariants    ProductVariant[]       @relation("VariantDeletedEvent")
  deletedCategories  ProductCategory[]      @relation("CategoryDeletedEvent")
  deletedCoupons     Coupon[]               @relation("CouponDeletedEvent")
  deletedMemberships StoreStaffMembership[] @relation("MembershipDeletedEvent")

  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)], map: "store_audit_events_store_created_idx")
  @@index([storeId, entityType, entityId, createdAt(sort: Desc)], map: "store_audit_events_entity_idx")
  @@map("store_audit_events")
}

model Customer {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String            @map("store_id") @db.Uuid
  email         String?           @db.Text
  /// ق-201: NULL for a guest — a shopper who bought without choosing a password.
  /// `customers_guest_or_password` CHECK: a row is a guest or it has a password.
  passwordHash  String?           @map("password_hash") @db.Text
  fullName      String            @map("full_name") @db.Text
  phone         String?           @db.Text
  phoneNormalized String?         @map("phone_normalized") @db.Text
  phoneVerifiedAt DateTime?       @map("phone_verified_at") @db.Timestamptz(6)
  /// ق-201: a shadow row keyed on the phone, created by guest checkout. Becomes a
  /// full account — orders included — the moment the shopper chooses a password.
  isGuest       Boolean           @default(false) @map("is_guest")
  /// PG-6 (ق-74): GENERATED ALWAYS AS (codiq_ar_normalize_v1(full_name)) STORED — migration 20260904090000.
  /// Read-only. NEVER name this field in a `data:` object; Postgres rejects a write to a generated column.
  searchFullName String?          @default(dbgenerated()) @map("search_full_name") @db.Text
  /// PG-6: GENERATED ALWAYS AS (codiq_ar_normalize_v1(email)) STORED — migration 20260904090000. Read-only.
  searchEmail   String?           @default(dbgenerated()) @map("search_email") @db.Text
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sessions      CustomerSession[]
  orders        StoreOrder[]      @relation("CustomerOrders")
  shoppingCarts ShoppingCart[]
  addresses     CustomerAddress[]
  checkoutRequests CheckoutRequest[]
  couponRedemptions CouponRedemption[]
  orderPrescriptions OrderPrescription[]

  @@unique([id, storeId])
  @@index([storeId])
  @@index([storeId, phoneNormalized])
  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)], map: "customers_store_created_id_idx")
  @@map("customers")
  productReviews ProductReview[]
  wishlistItems  WishlistItem[]
  returnRequests ReturnRequest[]
  loyaltyEntries LoyaltyEntry[]
}

/// PR-1 (19-أ) — «استعادة كلمة السر». A single-use, short-lived account recovery
/// token, stored as a HASH: the platform never keeps a copy of the link it mailed.
///
/// `subjectId` carries NO relation on purpose. Five identity kinds live in five
/// tables and a column cannot reference five parents, so the pair
/// (identityKind, subjectId) is the reference and the database CHECK pins the
/// kind to the five that exist. `storeId` is set for a customer and NULL for
/// everyone else — enforced by password_reset_tokens_store_scope, because a
/// storefront customer is only an identity once you also say at WHICH store.
model PasswordResetToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityKind      String    @map("identity_kind") @db.Text
  subjectId         String    @map("subject_id") @db.Uuid
  storeId           String?   @map("store_id") @db.Uuid
  /// sha256 hex of the mailed token. The token itself is never stored anywhere.
  tokenHash         String    @unique @map("token_hash") @db.Text
  emailNormalized   String    @map("email_normalized") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt     DateTime? @map("invalidated_at") @db.Timestamptz(6)
  invalidatedReason String?   @map("invalidated_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  store             Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // The live-token index is PARTIAL (WHERE consumed_at IS NULL AND
  // invalidated_at IS NULL) and lives ONLY in migration 20260905090000 —
  // Prisma cannot express a partial index, and an @@index here would generate a
  // second FULL index and create drift. Same rule as Merchant.phoneNormalized.
  @@map("password_reset_tokens")
}

model PaymentMethod {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  code          String   @db.Text
  displayName   String   @map("display_name") @db.Text
  isEnabled     Boolean  @default(false) @map("is_enabled")
  configuration Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
  @@map("payment_methods")
}

model NotificationSettings {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String   @unique @map("store_id") @db.Uuid
  provider      String?  @db.Text
  apiKey        String?  @map("api_key") @db.Text
  senderId      String?  @map("sender_id") @db.Text
  isEnabled     Boolean  @default(false) @map("is_enabled")
  /// PG-3: marketing messages per day for this store. Over it the worker defers
  /// to tomorrow rather than dropping; 0 disables marketing for the store.
  marketingDailyCap Int  @default(200) @map("marketing_daily_cap")
  /// 19-د: the operational channel's ceilings, which it had none of. The
  /// per-recipient one is the surgical control — no honest shopper receives
  /// twenty operational messages from one store in a day — and the per-store one
  /// is a circuit breaker set well clear of a busy store's real volume. Over
  /// either, the worker DEFERS to tomorrow rather than dropping. See
  /// notifications/messaging-compliance.service.ts for the arithmetic.
  operationalDailyCap          Int @default(5000) @map("operational_daily_cap")
  operationalRecipientDailyCap Int @default(20)   @map("operational_recipient_daily_cap")
  /// MD-3: opt-in daily summary of the merchant's OWN store. Operational, not
  /// marketing -- a marketing unsubscribe never silences it -- but still off
  /// until he asks, because a daily email nobody wanted is how a shared sending
  /// domain earns a spam reputation.
  dailyDigestEnabled Boolean @default(false) @map("daily_digest_enabled")
  /// Baghdad hour (0-23) after which that day's digest may go out. Iraq is
  /// UTC+3 with no daylight saving, so this is a constant offset.
  dailyDigestHour    Int     @default(20) @map("daily_digest_hour")
  configuration Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model DeliveryRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  governorate   String   @db.Text
  amountIqd     Int      @map("amount_iqd")
  isEnabled     Boolean  @default(false) @map("is_enabled")
