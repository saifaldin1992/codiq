model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  objectKey   String   @unique @map("object_key") @db.Text
  contentType String   @map("content_type") @db.Text
  /// ق-238: the SUM of every object this row names, not the size of what the
  /// merchant sent — the plan meter charges what storage actually holds.
  byteSize    Int      @map("byte_size")
  sortOrder   Int      @default(0) @map("sort_order")
  /// ق-238 — which set of objects exists behind `objectKey`.
  ///
  /// NULL is the pre-ق-238 row: one object, the merchant's original bytes, at
  /// `objectKey` exactly. 1 is {thumb 200, card 800, full 1600} webp, with
  /// `full` AT `objectKey` and the other two by suffix (`variantObjectKey`).
  /// Nullable and never backfilled: the old rows' variants do not exist, and a
  /// column that claimed otherwise would serve 404s for pictures that are fine.
  variantSet  Int?     @map("variant_set")
  /// Of `full`, after EXIF rotation. Present so the grid can reserve the box
  /// before the bytes arrive — a catalog that reflows as pictures land is the
  /// thing a shopper on a slow connection notices most. NULL on legacy rows.
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, sortOrder])
  @@map("product_images")
}

model InventoryMovement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  // PG-2 (D-48): nullable + ON DELETE SET NULL. A purged product no longer
  // annihilates its stock history; the snapshot columns below keep the row
  // readable forever. They are stamped by the
  // inventory_movements_stamp_snapshot BEFORE INSERT trigger, never by a
  // service, so every writer — raw SQL included — produces a complete row.
  productId String?  @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  delta     Int
  reason    String   @db.Text
  // @default(dbgenerated()) — the BEFORE INSERT trigger fills these, so they are
  // NOT NULL in the database yet omitted from every Prisma create input (the
  // same device this schema already uses for the generated is_low_stock column).
  productName String  @default(dbgenerated()) @map("product_name") @db.Text
  productSku  String  @default(dbgenerated()) @map("product_sku")  @db.Text
  variantName String? @map("variant_name") @db.Text
  variantSku  String? @map("variant_sku")  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, map: "inventory_movements_variant_fk")

  @@index([storeId, productId, createdAt])
  // ق-176: the whole store's log in time order, ending in the keyset tiebreaker.
  @@index([storeId, createdAt, id], map: "inventory_movements_store_created_id_idx")
  @@index([variantId], map: "inventory_movements_variant_idx")
  @@map("inventory_movements")
}

model StoreOrder {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String             @map("store_id") @db.Uuid
  customerId        String?            @map("customer_id") @db.Uuid
  orderNumber       String             @map("order_number") @db.Text
  status            String             @db.Text
  customerName      String             @map("customer_name") @db.Text
  /// PG-6 (ق-74): GENERATED ALWAYS AS (codiq_ar_normalize_v1(order_number)) STORED — migration 20260904090000.
  /// Read-only. NEVER name this field in a `data:` object; Postgres rejects a write to a generated column.
  searchOrderNumber String?            @default(dbgenerated()) @map("search_order_number") @db.Text
  /// PG-6: GENERATED ALWAYS AS (codiq_ar_normalize_v1(customer_name)) STORED — migration 20260904090000.
  /// Read-only. It is what finally lets a merchant find an order by the customer's name.
  searchCustomerName String?           @default(dbgenerated()) @map("search_customer_name") @db.Text
  /// PG-5 (ق-73): what the customer asked for at checkout — «اتصل قبل الوصول».
  /// The 500-character ceiling is a CHECK in migration 20260830090000.
  customerNote      String?            @map("customer_note") @db.Text
  customerEmail     String?            @map("customer_email") @db.Text
  recipientPhone    String?            @map("recipient_phone") @db.Text
  shippingGovernorate String?          @map("shipping_governorate") @db.Text
  shippingAddressLine1 String?         @map("shipping_address_line1") @db.Text
  shippingAddressLine2 String?         @map("shipping_address_line2") @db.Text
  subtotalIqd       Int                @default(0) @map("subtotal_iqd")
  deliveryFeeIqd    Int                @default(0) @map("delivery_fee_iqd")
  discountIqd       Int                @default(0) @map("discount_iqd")
  couponId          String?            @map("coupon_id") @db.Uuid
  couponCode        String?            @map("coupon_code") @db.Text
  prescriptionStatus String?           @map("prescription_status") @db.Text
  totalIqd          Int                @map("total_iqd")
  paymentStatus     String             @default("unpaid") @map("payment_status") @db.Text
  paymentMethodCode String             @default("legacy") @map("payment_method_code") @db.Text
  source            String             @default("legacy") @db.Text
  version           Int                @default(1)
  statusUpdatedAt   DateTime           @default(now()) @map("status_updated_at") @db.Timestamptz(6)
  updatedByKind     String?            @map("updated_by_kind") @db.Text
  /// POS offline v1 (ق-132/ق-136): when the cash actually changed hands at the
  /// till, per the device's clock CLAMPED server-side into [now − 30d, now].
  /// createdAt stays sync time (server truth); the POS takings aggregates key
  /// on THIS column so a Monday outage flushed Tuesday lands in Monday.
  /// NULL for every non-POS order — the storefront has no till clock.
  soldAt            DateTime?          @default(now()) @map("sold_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation("CustomerOrders", fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict)
  items             OrderItem[]
  statusEvents      OrderStatusEvent[]
  convertedCart     ShoppingCart?      @relation("ConvertedOrderCart")
  checkoutRequests  CheckoutRequest[]
  posTickets        PosTicket[]
  inventoryReservations InventoryReservation[]
  notificationOutbox NotificationOutbox[]
  ledgerEntries     LedgerEntry[]
  coupon            Coupon?            @relation(fields: [couponId, storeId], references: [id, storeId], onDelete: Restrict, map: "store_orders_coupon_store_fk")
  // DB-level UNIQUE(order_id) makes this one row max; Prisma models it as a list
  // because the composite FK fields (orderId, storeId) are not their own unique.
  couponRedemptions CouponRedemption[]
  prescriptions     OrderPrescription[]
  // MD-1: INTERNAL merchant surfaces. They are RELATIONS on purpose — a scalar
  // column would ride the top-level `include` that builds the customer's own
  // order payload, while a relation is only ever returned when a query names it
  // and no storefront/customer query does.
  internalNotes     OrderNote[]
  internalTags      OrderTag[]
  // WA-1 (ق-131/ق-139): the manual WhatsApp audit — a RELATION for the same
  // reason the notes are: no storefront/customer query names it, so the
  // recipient phone and message bodies can never ride the customer payload.
  whatsappSends     OrderWhatsappSend[]

  @@unique([storeId, orderNumber])
  @@unique([id, storeId])
  @@index([storeId])
  @@index([customerId])
  @@index([storeId, status, createdAt, id])
  @@index([storeId, createdAt, id])
  @@index([status, createdAt, id])
  // 20-3: the platform-wide order feed carries NO store filter and does not
  // always filter status, so neither index above leads with a column it
  // constrains. 178.55 ms of Seq Scan + Sort on 200,000 rows, measured.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "store_orders_created_id_idx")
  @@map("store_orders")
  productReviews ProductReview[]
  returnRequests ReturnRequest[]
  /// CD-5: what this order actually redeemed, so a receipt explains its own total.
  loyaltyPointsSpent Int @default(0) @map("loyalty_points_spent")
  loyaltyDiscountIqd Int @default(0) @map("loyalty_discount_iqd")
  loyaltyEntries LoyaltyEntry[]
  /// ق-246: who took the parcel, its waybill, when it left, and when its cash
  /// came back from the courier. All four NULL until the merchant records them.
  courierName    String?   @map("courier_name") @db.Text
  trackingNumber String?   @map("tracking_number") @db.Text
  handedOverAt   DateTime? @map("handed_over_at") @db.Timestamptz(3)
  codCollectedAt DateTime? @map("cod_collected_at") @db.Timestamptz(3)
  /// Partial in the migration (WHERE handed_over_at IS NOT NULL): the manifest
  /// and the reconciliation only ever ask for parcels that left.
  @@index([storeId, handedOverAt, id], map: "store_orders_store_handed_over_idx")
}

