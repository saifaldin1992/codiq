  customer          Customer?       @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict)
  mergedIntoCart    ShoppingCart?   @relation("CartMerge", fields: [mergedIntoCartId, storeId], references: [id, storeId], onDelete: Restrict)
  mergedFromCarts   ShoppingCart[]  @relation("CartMerge")
  convertedOrder    StoreOrder?     @relation("ConvertedOrderCart", fields: [convertedOrderId, storeId], references: [id, storeId], onDelete: Restrict)
  items             CartItem[]
  notificationOutbox NotificationOutbox[]

  @@unique([id, storeId])
  @@unique([convertedOrderId, storeId])
