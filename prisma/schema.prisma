model NotificationOutbox {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PR-1: NULLABLE since migration 20260905090000. A password-reset mail belongs
  /// to an IDENTITY, not to a store — the platform owner has no store at all, and
  /// attributing a merchant's recovery mail to one of his stores would let that
  /// store's daily cap defer, to tomorrow, a link that expires in 45 minutes.
  /// `notification_outbox_store_scope` names the event types allowed to go
  /// storeless, so the loosening cannot spread by accident.
  storeId       String?     @map("store_id") @db.Uuid
  eventType     String      @map("event_type") @db.Text
  orderId       String?     @map("order_id") @db.Uuid
  productId     String?     @map("product_id") @db.Uuid
  cartId        String?     @map("cart_id") @db.Uuid
  recipientKind String      @map("recipient_kind") @db.Text
  channel       String      @db.Text
  recipient     String?     @db.Text
  payload       Json        @default("{}") @db.JsonB
  dedupeKey     String?     @map("dedupe_key") @db.Text
  /// ق-249: a consumer that reads a v1 payload is never surprised by a v2 field that changed meaning.
  eventVersion  Int         @default(1) @map("event_version")
  status        String      @default("pending") @db.Text
  attemptCount  Int         @default(0) @map("attempt_count")
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  claimToken    String?     @map("claim_token") @db.Text
  claimedAt     DateTime?   @map("claimed_at") @db.Timestamptz(6)
  lastOutcome   String?     @map("last_outcome") @db.Text
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  store         Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order         StoreOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cart          ShoppingCart? @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // PG-3: the event type is a foreign key, so an unclassified notification
  // cannot be enqueued at all — adding one requires saying whether it is
  // marketing or operational in the same migration that introduces it.
  eventKind     NotificationEventKind @relation(fields: [eventType], references: [eventType], onUpdate: Cascade, onDelete: Restrict)
  complaints    NotificationComplaint[]

  /// ق-185: this index cannot see a store-less row. Postgres treats NULLs as
  /// distinct, so UNIQUE(NULL, 'k') never collides with itself and a merchant
  /// ACCOUNT message (store_id IS NULL) would be re-enqueued on every scanner
  /// pass. The partial index `notification_outbox_dedupe_no_store` covers that
  /// half and lives only in the migration — Prisma cannot express a WHERE on an
  /// index. Do not "simplify" this by adding NULLS NOT DISTINCT here: most rows
  /// carry no dedupe key at all, and they would all begin colliding.
  @@unique([storeId, dedupeKey], map: "notification_outbox_dedupe")
  @@index([status, nextAttemptAt], map: "notification_outbox_claim_idx")
  @@index([storeId, createdAt(sort: Desc), id], map: "notification_outbox_store_log_idx")
  @@index([orderId], map: "notification_outbox_order_idx")
  @@index([cartId], map: "notification_outbox_cart_idx")
  @@index([storeId, sentAt], map: "notification_outbox_store_sent_idx")
  /// 19-د: the per-recipient operational counter reads this. Without it the
  /// worker rescans the store's whole outbox for every operational row.
  @@index([storeId, recipient, sentAt], map: "notification_outbox_store_recipient_sent_idx")
  @@map("notification_outbox")
}

/// PG-3: whether a notification is marketing (needs consent and an unsubscribe
