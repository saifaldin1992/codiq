model NotificationComplaint {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  outboxId        String?             @map("outbox_id") @db.Uuid
  emailNormalized String              @map("email_normalized") @db.Text
  note            String?             @db.Text
  reportedAt      DateTime            @default(now()) @map("reported_at") @db.Timestamptz(3)
  /// ق-182: the provider's event id — Svix redelivers, and one event is one complaint.
  providerEventId String?             @unique(map: "notification_complaints_provider_event_uq") @map("provider_event_id") @db.Text
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  outbox          NotificationOutbox? @relation(fields: [outboxId], references: [id], onDelete: SetNull)

  @@index([storeId, reportedAt(sort: Desc), id(sort: Desc)], map: "notification_complaints_store_reported_idx")
  /// ق-182: the owner's platform-wide list, newest first, ending in the keyset tiebreaker.
  @@index([reportedAt(sort: Desc), id(sort: Desc)], map: "notification_complaints_reported_id_idx")
  @@map("notification_complaints")
}

model PlatformSetting {
  key       String   @id @db.Text
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model LedgerEntry {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String     @map("store_id") @db.Uuid
  orderId       String     @map("order_id") @db.Uuid
  entryType     String     @map("entry_type") @db.Text
  subtotalIqd   Int        @map("subtotal_iqd")
  deliveryFeeIqd Int       @map("delivery_fee_iqd")
  /// 19-د: what points paid for on this order. SUBTRACTED from the payout — the
  /// courier never collected it — while `subtotalIqd` stays the commissionable
  /// net (decision §8.4). Nullable because rows written before the column
  /// existed cannot be corrected: the ledger is append-only.
  loyaltyDiscountIqd Int?  @default(0) @map("loyalty_discount_iqd")
  commissionIqd Int        @map("commission_iqd")
  commissionBps Int        @map("commission_bps")
  planCode      String     @map("plan_code") @db.Text
  note          String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order         StoreOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt(sort: Desc), id], map: "ledger_entries_store_created_idx")
  @@index([orderId], map: "ledger_entries_order_idx")
  @@index([entryType, createdAt], map: "ledger_entries_type_created_idx")
  @@map("ledger_entries")
}

model Settlement {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String         @map("merchant_id") @db.Uuid
  /// 19-ب: optional since platform staff may settle too. The one-of CHECK
  /// (`settlements_settled_by_one_of`) still requires SOME recorded actor.
  platformOwnerId String?        @map("platform_owner_id") @db.Uuid
  settledByStaffId String?       @map("settled_by_staff_id") @db.Uuid
  /// TEXT snapshot of the settling staff member — the row must outlive him.
  settledByLabel  String?        @map("settled_by_label") @db.Text
  periodFrom      DateTime       @map("period_from") @db.Timestamptz(6)
  periodTo        DateTime       @map("period_to") @db.Timestamptz(6)
  ordersCount     Int            @map("orders_count")
  subtotalIqd     Int            @map("subtotal_iqd")
  deliveryFeeIqd  Int            @map("delivery_fee_iqd")
  /// 19-د: the points half of the period, so the settlement's own components
  /// still add up to the money actually transferred.
  loyaltyDiscountIqd Int?        @default(0) @map("loyalty_discount_iqd")
  commissionIqd   Int            @map("commission_iqd")
  /// Audit 17-ب: GENERATED in the database (subtotal + delivery − points − commission) —
  /// the amount actually transferred. Never written by the application.
  netPayoutIqd    Int?           @default(dbgenerated()) @map("net_payout_iqd")
  note            String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  platformOwner   PlatformOwner? @relation(fields: [platformOwnerId], references: [id], onDelete: Restrict)
  settledByStaff  PlatformStaff? @relation("SettlementSettledByStaff", fields: [settledByStaffId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt(sort: Desc), id], map: "settlements_merchant_created_idx")
  @@index([settledByStaffId], map: "settlements_settled_by_staff_idx")
  @@map("settlements")
}

model Coupon {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String             @map("store_id") @db.Uuid
  code               String             @db.Text
  codeNormalized     String             @map("code_normalized") @db.Text
  kind               String             @db.Text
  percentOff         Int?               @map("percent_off")
  amountOffIqd       Int?               @map("amount_off_iqd")
  minSubtotalIqd     Int                @default(0) @map("min_subtotal_iqd")
  maxUsesTotal       Int?               @map("max_uses_total")
  maxUsesPerCustomer Int?               @map("max_uses_per_customer")
  startsAt           DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime?          @map("ends_at") @db.Timestamptz(6)
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // PG-2 soft delete.
  deletedAt          DateTime?          @map("deleted_at")         @db.Timestamptz(6)
  deletedEventId     String?            @map("deleted_event_id")   @db.Uuid
  deletedWasActive   Boolean?           @map("deleted_was_active")
  purgeBlockedAt     DateTime?          @map("purge_blocked_at")   @db.Timestamptz(6)
  purgeBlockReason   String?            @map("purge_block_reason") @db.Text
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deletedEvent       StoreAuditEvent?   @relation("CouponDeletedEvent", fields: [deletedEventId], references: [id], onDelete: Restrict)
  redemptions        CouponRedemption[]
  orders             StoreOrder[]

  // PG-2: @@unique([storeId, codeNormalized]) removed — replaced by the partial
  // unique index coupons_store_code_live_key (migration 20260828090200). Its
  // removal is a WANTED compile break: it forces every
  // findUnique({ storeId_codeNormalized }) into findFirst({ …, ...LIVE }).
  @@unique([id, storeId], map: "coupons_id_store_unique")
  @@index([storeId, isActive], map: "coupons_store_idx")
  @@map("coupons")
}

model CouponRedemption {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String     @map("store_id") @db.Uuid
  couponId             String     @map("coupon_id") @db.Uuid
  orderId              String     @map("order_id") @db.Uuid
  customerId           String     @map("customer_id") @db.Uuid
  discountIqd          Int        @default(0) @map("discount_iqd")
  waivedDeliveryFeeIqd Int        @default(0) @map("waived_delivery_fee_iqd")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  store                Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  coupon               Coupon     @relation(fields: [couponId, storeId], references: [id, storeId], onDelete: Restrict, map: "coupon_redemptions_coupon_store_fk")
  order                StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict, map: "coupon_redemptions_order_store_fk")
  customer             Customer   @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, map: "coupon_redemptions_customer_store_fk")

  @@unique([orderId], map: "coupon_redemptions_order_unique")
  @@index([couponId], map: "coupon_redemptions_coupon_idx")
  @@index([storeId, couponId, customerId], map: "coupon_redemptions_coupon_customer_idx")
  @@map("coupon_redemptions")
}

model OrderPrescription {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  customerId     String     @map("customer_id") @db.Uuid
  objectKey      String     @unique @map("object_key") @db.Text
  contentType    String     @map("content_type") @db.Text
  byteSize       Int        @map("byte_size")
  reviewStatus   String     @default("pending") @map("review_status") @db.Text
  reviewedByKind String?    @map("reviewed_by_kind") @db.Text
  reviewedById   String?    @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade, map: "order_prescriptions_order_store_fk")
  customer       Customer   @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, map: "order_prescriptions_customer_store_fk")

  @@index([storeId, orderId, createdAt], map: "order_prescriptions_order_idx")
  @@map("order_prescriptions")
}

model StoreMarketingSettings {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String   @unique @map("store_id") @db.Uuid
  metaPixelId      String?  @map("meta_pixel_id") @db.Text
  tiktokPixelId    String?  @map("tiktok_pixel_id") @db.Text
  ga4MeasurementId String?  @map("ga4_measurement_id") @db.Text
  isEnabled        Boolean  @default(false) @map("is_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_marketing_settings")
}

/**
 * MD-1 — INTERNAL order notes for the merchant and their staff. No storefront
 * or customer route reads this table; the composite (orderId, storeId) FK makes
 * same-store membership structural.
 */
model OrderNote {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String     @map("store_id") @db.Uuid
  orderId    String     @map("order_id") @db.Uuid
  authorKind String     @map("author_kind") @db.Text
  authorId   String     @map("author_id") @db.Uuid
  body       String     @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order      StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade, map: "order_notes_order_store_fk")

  @@index([storeId, orderId, createdAt], map: "order_notes_store_order_idx")
  @@map("order_notes")
}

/**
 * WA-1 (ق-131/ق-139) — the manual WhatsApp channel's audit. Each row is an act
 * a PERSON performed: he tapped «أرسل عبر واتساب» and his own WhatsApp opened
 * with the server-rendered message. It records intent, never claims delivery —
 * a wa.me link cannot know whether the human pressed send. Deliberately NOT an
 * outbox row: the outbox models messages the SYSTEM will deliver (claim/retry/
 * provider lifecycle); this models a human act with none of that. The automated
 * WhatsApp era (25ب) adds outbox rows beside these, it does not migrate them.
 */
model OrderWhatsappSend {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  templateKey    String     @map("template_key") @db.Text
  recipientPhone String     @map("recipient_phone") @db.Text
  messageBody    String     @map("message_body") @db.Text
  actorKind      String     @map("actor_kind") @db.Text
  actorId        String     @map("actor_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade, map: "order_whatsapp_sends_order_fk")

  @@index([storeId, orderId, createdAt(sort: Desc)], map: "order_whatsapp_sends_order_idx")
  @@map("order_whatsapp_sends")
}

/**
 * MD-1 — INTERNAL per-order labels. A child table (never a scalar column) so the
 * customer order payload, which is built with a top-level `include`, cannot
 * surface them by accident. UNIQUE(order_id, tag_normalized) plus the length
 * CHECK and the 8-per-order constraint trigger keep the caps structural.
 */
model OrderTag {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String     @map("store_id") @db.Uuid
  orderId       String     @map("order_id") @db.Uuid
  tag           String     @db.Text
  tagNormalized String     @map("tag_normalized") @db.Text
  position      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order         StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade, map: "order_tags_order_store_fk")

  @@unique([orderId, tagNormalized], map: "order_tags_order_unique")
  @@index([storeId, orderId, position], map: "order_tags_store_order_idx")
  // Serves the SERVER-side tag filter and the chip facet in listStoreOrders.
  // The GIN/pg_trgm search indexes from the same migration are not expressible
  // in this schema language and live in the migration only.
  @@index([storeId, tagNormalized], map: "order_tags_store_tag_idx")
  @@map("order_tags")
}

/// 19-د: the labels a merchant may not claim as a store slug or subdomain,
/// because the platform answers on them. Mirrored by
/// `services/reserved-slugs.ts` (the application's refusal) and enforced here by
/// `codiq_guard_reserved_store_slug`, which fires on INSERT and on a slug that
/// actually changes — a store that already carries a reserved slug keeps it
/// rather than being renamed behind its owner's back. `phase17:test` asserts
/// the two lists have not drifted apart.
model ReservedStoreSlug {
  slug      String   @id @db.Text
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("reserved_store_slugs")
}

model StorefrontRateLimit {
  scope           String   @db.Text
  keyHash         String   @map("key_hash") @db.Text
  windowStartedAt DateTime @default(now()) @map("window_started_at") @db.Timestamptz(6)
  attemptCount    Int      @default(1) @map("attempt_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([scope, keyHash])
  @@index([updatedAt])
  @@map("storefront_rate_limits")
}

/// CD-2: a product review. The verified-buyer badge is `orderId`, not a flag —
/// every row names the completed order that entitles it, matched by
/// (id, storeId, customerId) at write time. A row cannot exist without a purchase.
model ProductReview {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  /// The order that proves the purchase. Never null.
  orderId      String    @map("order_id") @db.Uuid
  rating       Int
  body         String?   @db.Text
  /// The merchant hid the TEXT. The rating still counts toward the average.
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenReason String?   @map("hidden_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// The SHOPPER withdrew his own review. Deliberately not `deletedAt`: that
  /// name belongs to the merchant's trash, and a withdrawn review is not his
  /// to restore.
  withdrawnAt  DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade)
  order    StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)

  @@map("product_reviews")
}

/// CD-2: a saved variant. Variant-level on purpose — «نبّهني عند التوفر» is a
/// question about a size, and answering it for the product would send a shopper
/// to a page where the thing he wanted is still missing.
model WishlistItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  /// Saving is not asking to be paged. Defaults off.
  notifyOnRestock Boolean  @default(false) @map("notify_on_restock")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade)
  product  Product        @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([storeId, customerId, variantId])
  // 20-3: the uniqueness index above finds the shopper's rows and then TOP-N
  // SORTS her whole saved list on every page — 0.178 ms at 500 items, growing
  // with the list. This one is walked in order instead: 0.038 ms, flat.
  @@index([storeId, customerId, createdAt(sort: Desc), id(sort: Desc)], map: "wishlist_items_customer_created_id_idx")
  @@map("wishlist_items")
}

/// CD-3: a shopper's return request and the merchant's answer.
///
/// This model NEVER touches money. Approving a request calls
/// `transitionOrderStatus(..., "returned")` — the one path that reverses a
/// ledger entry — so the 15-day window and the already-reversed guard are
/// checked in exactly one place.
model ReturnRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  status           String    @default("requested") @db.Text
  reason           String    @db.Text
  decisionNote     String?   @map("decision_note") @db.Text
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByKind    String?   @map("decided_by_kind") @db.Text
  decidedById      String?   @map("decided_by_id") @db.Uuid
  /// When automatic financial reversal stops being possible for this order.
  reversalDeadline DateTime  @map("reversal_deadline") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade)

  // 20-3: the merchant returns queue is oldest-first and filters `status` only
  // sometimes; `return_requests_queue_idx` (migration 20260830140000) leads
  // with that optional status, so the unfiltered queue could not ride it.
  @@index([storeId, createdAt, id], map: "return_requests_store_created_id_idx")
  @@map("return_requests")
}

/// CD-5: the points history. APPEND-ONLY (trigger `loyalty_entries_immutable`),
/// and there is deliberately no balance column anywhere — the balance is the
/// signed sum of these rows. A stored balance that disagrees with its own
/// history is the defining loyalty bug.
///
/// `points` is always POSITIVE; the sign lives in `kind`, so a query that
/// forgets to apply it produces an obviously wrong total rather than a plausible
/// one.
///
/// LOY-1: an `earned` row is also a LOT — it carries the rate its points were
/// earned at, and redemption prices each lot at its own rate. The remaining
/// balance is therefore a FOLD of this same log, never a second table.
model LoyaltyEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  /// earned | spent | reversed_earn | refunded_spend
  kind       String   @db.Text
  points     Int
  /// IQD the points were worth when spent, snapshotted. Null for earn rows.
  valueIqd   Int?     @map("value_iqd")
  /// LOY-1: IQD ONE point of this lot was worth when it was EARNED. An `earned`
  /// row is a LOT, and it carries its own price so a later rate change cannot
  /// re-price points a shopper already holds. Null on every other kind — a
  /// spend can span several lots at several rates, and its total is `valueIqd`.
  pointValueIqd Int?  @map("point_value_iqd")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade)
  order    StoreOrder @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([orderId, kind], map: "loyalty_entries_one_per_order_kind_uq")
  @@map("loyalty_entries")
}

/// Phase 19: single-use ways past the second factor.
///
/// Mandatory, not a nicety: this platform has ONE owner and no support desk
/// above him. A lost phone without these is an account nobody on earth can
/// restore. Hashed like passwords, because a recovery code IS a password — it
/// is the one thing that gets past the factor.
model PlatformOwnerRecoveryCode {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformOwnerId String    @map("platform_owner_id") @db.Uuid
  codeHash        String    @map("code_hash") @db.Text
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformOwner PlatformOwner @relation(fields: [platformOwnerId], references: [id], onDelete: Cascade)

  @@map("platform_owner_recovery_codes")
}

/// ق-132 — a till the merchant paired. Revocable, never deleted: past sales
/// keep their provenance, and «this device was revoked on X» stays a fact.
model PosDevice {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String      @map("store_id") @db.Uuid
  label       String      @db.Text
  deviceShort String      @map("device_short") @db.Text
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tickets     PosTicket[]

  @@unique([id, storeId])
  @@unique([storeId, deviceShort])
  @@index([storeId, createdAt(sort: Desc)], map: "pos_devices_store_idx")
  @@map("pos_devices")
}

/// ق-132 — device-minted idempotency for a counter sale. The UNIQUE on
/// (store, device, ticket) makes a retry COLLIDE and return the original order
/// instead of selling twice. Transliterated from CheckoutRequest, with the
/// customer swapped for a device. NO ledger entry is ever written for a POS
/// sale — ق-135: the platform never held this money.
model PosTicket {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String               @map("store_id") @db.Uuid
  deviceId           String               @map("device_id") @db.Uuid
  ticketId           String               @map("ticket_id") @db.Uuid
  requestFingerprint String               @map("request_fingerprint") @db.Text
  status             String               @default("processing") @db.Text
  orderId            String?              @map("order_id") @db.Uuid
  deviceReportedAt   DateTime             @map("device_reported_at") @db.Timestamptz(6)
  receivedAt         DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  device             PosDevice            @relation(fields: [deviceId, storeId], references: [id, storeId], onDelete: Restrict)
  order              StoreOrder?          @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)
  shortfalls         PosTicketShortfall[]
  priceDeviations    PosPriceDeviation[]

  @@unique([storeId, deviceId, ticketId])
  @@unique([id, storeId])
  @@index([storeId, deviceId, createdAt(sort: Desc)], map: "pos_tickets_lookup_idx")
  @@map("pos_tickets")
}

/// ق-132 — stock the till sold that the shelf no longer had by sync time.
/// The decrement clamps at zero (the CHECK forbids negatives) and the gap is
/// recorded HERE, loudly, for the merchant to reconcile — an accepted lie
/// about stock beats a rejected truth about a sale that already happened.
model PosTicketShortfall {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String         @map("store_id") @db.Uuid
  posTicketId  String         @map("pos_ticket_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  soldQty      Int            @map("sold_qty")
  availableQty Int            @map("available_qty")
  shortfallQty Int            @map("shortfall_qty")
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ticket       PosTicket      @relation(fields: [posTicketId, storeId], references: [id, storeId], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@map("pos_ticket_shortfalls")
}

/// A till price that differed from the catalog at sync time, or a ticket-level
/// discount — written beside the sale, never refusing it, reviewed by the owner.
model PosPriceDeviation {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String          @map("store_id") @db.Uuid
  posTicketId         String          @map("pos_ticket_id") @db.Uuid
  variantId           String?         @map("variant_id") @db.Uuid
  kind                String          @db.Text
  quantity            Int
  soldUnitPriceIqd    Int             @map("sold_unit_price_iqd")
  catalogUnitPriceIqd Int             @map("catalog_unit_price_iqd")
  amountIqd           Int             @map("amount_iqd")
  reviewedAt          DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  store               Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ticket              PosTicket       @relation(fields: [posTicketId, storeId], references: [id, storeId], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([posTicketId], map: "pos_price_deviations_ticket_idx")
  @@map("pos_price_deviations")
}

/// ق-202: daily visit totals per store — no identity, no IP, no path; Baghdad
/// calendar days. isitors is deduplicated by a first-party cookie holding
/// only the day it was last counted on. Read and written with raw SQL so the
/// DATE column never passes through a JS Date's timezone.
model StoreVisitDaily {
  storeId  String   @map("store_id") @db.Uuid
  day      DateTime @db.Date
  visits   Int      @default(0)
  visitors Int      @default(0)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day])
  @@map("store_visits_daily")
}

/// ق-202: product views per day, feeding «الأكثر زيارة» on the merchant's home.
model ProductViewDaily {
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  day       DateTime @db.Date
  views     Int      @default(0)
  product   Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)

  @@id([storeId, productId, day])
  @@index([storeId, day])
  @@map("product_views_daily")
}

/// ق-249 — المرحلة 29: what the platform offers, as rows. A service groups capabilities;
/// each carries a DEFAULT state the owner edits from his screen (available | coming_soon |
/// disabled | deprecated | retired). Effective availability is resolved per tenant in
/// `availability.service.ts`, with overrides, store status and flags layered on top.
model Service {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String       @unique @db.Text
  name         String       @db.Text
  description  String       @default("") @db.Text
  state        String       @default("available") @db.Text
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  capabilities Capability[]
  dependencies ServiceDependency[]
  overrides    AvailabilityOverride[]
  maintenanceWindows MaintenanceWindow[]

  @@map("services")
}

model Capability {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String    @map("service_id") @db.Uuid
  code        String    @unique @db.Text
  name        String    @db.Text
  description String    @default("") @db.Text
  state       String    @default("available") @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  overrides   AvailabilityOverride[]
  maintenanceWindows MaintenanceWindow[]

  @@index([serviceId, sortOrder], map: "capabilities_service_sort_idx")
  @@map("capabilities")
}

/// kind = service (target: another service code) | external (target: a key the server checks — mail_provider …).
model ServiceDependency {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  kind      String   @db.Text
  target    String   @db.Text
  note      String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, kind, target], map: "service_dependencies_unique")
  @@map("service_dependencies")
}

/// One row: in this scope (platform | merchant | store) this service OR capability is in this
/// state, for this reason, between these moments. Revoked by stamping, never deleted.
model AvailabilityOverride {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope         String      @db.Text
  merchantId    String?     @map("merchant_id") @db.Uuid
  storeId       String?     @map("store_id") @db.Uuid
  serviceId     String?     @map("service_id") @db.Uuid
  capabilityId  String?     @map("capability_id") @db.Uuid
  state         String      @db.Text
  reason        String      @db.Text
  startsAt      DateTime?   @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?   @map("ends_at") @db.Timestamptz(3)
  createdByKind String      @map("created_by_kind") @db.Text
  createdById   String      @map("created_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokedByKind String?     @map("revoked_by_kind") @db.Text
  revokedById   String?     @map("revoked_by_id") @db.Uuid
  merchant      Merchant?   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store         Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  capability    Capability? @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "availability_overrides_created_id_idx")
  @@map("availability_overrides")
}

/// A rollout switch, never an authorization: the resolver reads it LAST.
model FeatureFlag {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String            @unique @db.Text
  description    String            @default("") @db.Text
  enabledDefault Boolean           @default(false) @map("enabled_default")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  rules          FeatureFlagRule[]

  @@map("feature_flags")
}

model FeatureFlagRule {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flagId     String      @map("flag_id") @db.Uuid
  scope      String      @db.Text
  planId     String?     @map("plan_id") @db.Uuid
  merchantId String?     @map("merchant_id") @db.Uuid
  storeId    String?     @map("store_id") @db.Uuid
  percentage Int?
  enabled    Boolean
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  flag       FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  plan       Plan?       @relation(fields: [planId], references: [id], onDelete: Cascade)
  merchant   Merchant?   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([flagId], map: "feature_flag_rules_flag_idx")
  @@map("feature_flag_rules")
}

/// ق-250: a maintenance window is LIVE when now() sits inside [startsAt, endsAt) and status = scheduled —
/// computed at read time, never flipped by a worker. `status` carries only what the clock cannot derive.
model MaintenanceWindow {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String      @db.Text
  serviceId       String?     @map("service_id") @db.Uuid
  capabilityId    String?     @map("capability_id") @db.Uuid
  merchantId      String?     @map("merchant_id") @db.Uuid
  storeId         String?     @map("store_id") @db.Uuid
  startsAt        DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime    @map("ends_at") @db.Timestamptz(3)
  timezone        String      @default("Asia/Baghdad") @db.Text
  messageAr       String      @map("message_ar") @db.Text
  messageEn       String?     @map("message_en") @db.Text
  affects         Json        @default("[]") @db.JsonB
  status          String      @default("scheduled") @db.Text
  createdByKind   String      @map("created_by_kind") @db.Text
  createdById     String      @map("created_by_id") @db.Uuid
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledByKind String?     @map("cancelled_by_kind") @db.Text
  cancelledById   String?     @map("cancelled_by_id") @db.Uuid
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  service         Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  capability      Capability? @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  merchant        Merchant?   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store           Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status, startsAt, endsAt], map: "maintenance_windows_live_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "maintenance_windows_created_id_idx")
  @@map("maintenance_windows")
}

/// ق-250: an incident with its four states; `blocks` decides whether the affected capabilities close or merely say so.
model Incident {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status        String           @default("investigating") @db.Text
  severity      String           @default("minor") @db.Text
  title         String           @db.Text
  publicMessage String           @map("public_message") @db.Text
  affects       Json             @default("[]") @db.JsonB
  blocks        Boolean          @default(false)
  startedAt     DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt    DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdByKind String           @map("created_by_kind") @db.Text
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updates       IncidentUpdate[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "incidents_created_id_idx")
  @@map("incidents")
}

/// Append-only (trigger `incident_updates_immutable`): the incident's history.
model IncidentUpdate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId    String   @map("incident_id") @db.Uuid
  status        String   @db.Text
  message       String   @db.Text
  createdByKind String   @map("created_by_kind") @db.Text
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt], map: "incident_updates_incident_idx")
  @@map("incident_updates")
}

/// ق-251: the merchant level of the configuration hierarchy — registry codes only (CHECK merchant_settings_code).
model MerchantSetting {
  merchantId    String   @map("merchant_id") @db.Uuid
  code          String   @db.Text
  value         Json     @db.JsonB
  updatedByKind String   @map("updated_by_kind") @db.Text
  updatedById   String   @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, code])
  @@map("merchant_settings")
}
