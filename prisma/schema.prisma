  searchSku         String? @default(dbgenerated()) @map("search_sku") @db.Text
  /// PG-6: GENERATED ALWAYS AS (codiq_ar_normalize_v1(description)) STORED — migration 20260904090000. Read-only.
  searchDescription String? @default(dbgenerated()) @map("search_description") @db.Text
  requiresPrescription Boolean @default(false) @map("requires_prescription")
  /// ق-199: typed attribute groups («النوتة العطرية»: مقدمة/قلب/قاعدة) — a list of
  /// `{ group, rows: [{ key, value }] }`, shape fixed by zod, label owned by the merchant.
