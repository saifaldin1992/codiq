  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  deletedEvent StoreAuditEvent? @relation("ProductDeletedEvent", fields: [deletedEventId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  variants    ProductVariant[]
  inventoryMovements InventoryMovement[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  inventoryReservations InventoryReservation[]
  notificationOutbox NotificationOutbox[]

  // PG-2: @@unique([storeId, sku]) was REMOVED. Its replacement is the partial
  // unique index products_store_sku_live_key ON (store_id, sku)
  // WHERE deleted_at IS NULL, which lives in migration 20260828090200 alone —
  // the same policy as plans_single_recommended (20260827170000) and order_tags.
  // Do NOT bring it back here: doing so re-locks the SKU on a product that is
  // sitting in the trash bin.
  @@unique([id, storeId])
  @@index([storeId])
  @@index([storeId, categoryId])
  @@index([storeId, stockQuantity])
  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)], map: "products_store_created_id_idx")
  // The trash/purge-sweep indexes are PARTIAL (WHERE deleted_at IS NOT NULL) and
